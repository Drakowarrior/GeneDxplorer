# GeneDxplorer Backend Production Engineering Configuration
# Copy this file to .env and adjust configuration as needed.

# Application Version
GENEDXPLORER_VERSION=1.0.0

# NCBI Entrez Configuration
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=

# Retrieval & Analysis Controls
ANALYSIS_LIMIT=500
NCBI_BATCH_SIZE=100
NCBI_REQUEST_DELAY=0.2

# Server-Side Cache TTL (in seconds, default 3600 = 1 hour)
CACHE_TTL=3600

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Server Host & Port
API_HOST=127.0.0.1
API_PORT=8000

# Allowed CORS Origins (comma-separated list, include your Vercel deployment URL in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,https://your-genedxplorer.vercel.app
